# CoverWise Backend Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to Git

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://coverwise_user:CHANGE_ME@localhost:5432/coverwise

# Application secret (generate a strong random string)
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Admin seed credentials (used only during initial setup)
ADMIN_EMAIL=admin@coverwise.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Advisor seed credentials prefix (advisors get email from dataset)
ADVISOR_DEFAULT_PASSWORD=CHANGE_ME_ADVISOR_PASSWORD

# Environment: development | production
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# B2 dataset directory (relative to FULL_CODE/)
B2_DATA_DIR=data/B2_Life_Insurance_Needs_Finder/data

# Session settings
SESSION_MAX_AGE_SECONDS=1800
